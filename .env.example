# =============================================================================
# Olimpo — variáveis de ambiente
# =============================================================================
# Copie para .env e preencha:  cp .env.example .env
# NUNCA commite o .env  (já está no .gitignore)
# =============================================================================

# --- ambiente ----------------------------------------------------------------
OLIMPO_ENV=development           # development | staging | production
LOG_LEVEL=INFO
# Interruptor mestre. false = nada é despachado ao android-orchestrator;
# tudo é gravado em disco. Mantenha false até a Fase 1 estar validada.
DISPATCH_ENABLED=false
# Kill switch global. true = todos os agentes param imediatamente.
GLOBAL_KILL_SWITCH=false

# --- postgres ----------------------------------------------------------------
POSTGRES_USER=olimpo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=olimpo
POSTGRES_PORT=5432

# --- redis -------------------------------------------------------------------
REDIS_PORT=6379

# --- portas ------------------------------------------------------------------
API_PORT=8000
PANEL_PORT=3000
LITELLM_PORT=4000
ADMINER_PORT=8080
FLOWER_PORT=5555
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=olimpo

# --- segurança ---------------------------------------------------------------
# Gere com: openssl rand -hex 32
SECRET_KEY=
API_TOKEN=
PANEL_API_URL=http://localhost:8000

# =============================================================================
# LLM
# =============================================================================
# Mac minis rodando Ollama. Do container, o host é host.docker.internal.
# Se os Macs estiverem na LAN, troque pelo IP real (ex.: http://192.168.1.50:11434)
# GPU local do host, se houver. Exige OLLAMA_HOST=0.0.0.0 no host:
#   /etc/systemd/system/ollama.service.d/bind.conf
LOCAL_GPU_URL=http://host.docker.internal:11434

MAC_MINI_1_URL=http://host.docker.internal:11434
MAC_MINI_2_URL=http://host.docker.internal:11435

# Fallback / tarefas que exigem qualidade
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LITELLM_MASTER_KEY=sk-troque-esta-chave
# Teto de gasto diário com APIs externas (USD). 0 = só LLM local.
# ⚠️ Ao mudar aqui, ajuste também `litellm_settings.max_budget` em
# ops/litellm.config.yaml — o LiteLLM exige float literal e não lê env var
# nesse campo. O valor lá deve ficar ~20% acima deste, para que o corte do
# Olimpo aconteça antes do corte do gateway.
LLM_DAILY_BUDGET_USD=5.0

# =============================================================================
# SERVIÇOS EXISTENTES  (ver docs/contratos/)
# =============================================================================

# android-orchestrator — executa e VERIFICA ações em device real.
# ⚠️ A lista real de servidores vive na tabela `orchestrator_nodes` e é
# gerenciada no painel (aba Servidores). As duas variáveis abaixo servem só
# para semear o primeiro nó numa instalação nova.
# SEMPRE a porta do WORKER (8078). A 8077 é o executor, que monta o
# docker.sock e escuta só em loopback.
ORCHESTRATOR_URL=http://host.docker.internal:9000
ORCHESTRATOR_TOKEN=
# (não há webhook no orchestrator: a confirmação é por polling — ADR-0011)

# máquina de influencers — persona, história, geração de foto/vídeo
PERSONA_ENGINE_URL=http://host.docker.internal:9100
PERSONA_ENGINE_TOKEN=

# android-manager — frota redroid (somente leitura: saúde dos devices)
ANDROID_MANAGER_URL=http://host.docker.internal:9200
ANDROID_MANAGER_TOKEN=

# media-forge — cortes/edição de vídeo  [Fase 5]
MEDIA_FORGE_URL=
MEDIA_FORGE_TOKEN=

# =============================================================================
# OPERAÇÃO
# =============================================================================
WORKER_CONCURRENCY=8

# Anti-detecção: jitter mínimo/máximo (minutos) entre contas da mesma campanha
CAMPAIGN_JITTER_MIN_MINUTES=25
CAMPAIGN_JITTER_MAX_MINUTES=240
# Fração máxima da frota que participa de uma campanha (0..1)
CAMPAIGN_MAX_PARTICIPATION=0.6
# Teto de ações/hora por conta (nunca ultrapassar, mesmo em campanha)
ACCOUNT_MAX_ACTIONS_PER_HOUR=12

# Taxa de revisão humana por amostragem no nível L2 (0..1)
L2_SAMPLING_RATE=0.10
